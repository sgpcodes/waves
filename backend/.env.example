# Copie para ".env" (desenvolvimento) ou cadastre como Environment
# Variables no Render (produção).

# Gere uma com:
# python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=troque-esta-chave

# "True" local, "False" em produção.
DEBUG=True

# Domínios aceitos, separados por vírgula. No Render o domínio
# xxx.onrender.com já entra sozinho (RENDER_EXTERNAL_HOSTNAME).
ALLOWED_HOSTS=localhost,127.0.0.1

# Supabase -> botão "Connect" -> "Session pooler" (porta 5432). Exemplo:
# postgresql://postgres.SEU_PROJETO:SUA_SENHA@aws-0-sa-east-1.pooler.supabase.com:5432/postgres
# Vazio = usa SQLite local (só pra desenvolvimento).
DATABASE_URL=

# URL(s) do frontend, separadas por vírgula. Vazio = libera qualquer origem.
# Ex.: https://ondas-frontend.onrender.com,http://localhost:5173
CORS_ALLOWED_ORIGINS=
